{
  "name": "theatre4u",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "app:sync": "npm run build && npx cap sync",
    "app:ios": "npm run app:sync && npx cap open ios",
    "app:android": "npm run app:sync && npx cap open android",
    "app:assets": "npx @capacitor/assets generate --assetPath mobile/assets"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^14.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "@vercel/edge": "^1.3.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor-mlkit/barcode-scanning": "^6.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "vitest": "^2.0.0",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "typescript": "^5.5.4"
  }
}